# ==============================================================================
# LAMU-AI Environment Configuration
# ==============================================================================

# --- MongoDB Atlas Vector Database ---
MONGODB_URI=
MONGODB_DB_NAME=lamu_ai_db
MONGODB_COLLECTION_NAME=antimicrobial_vectors
MONGODB_INDEX_NAME=vector_index_vetbert

# --- Active LLM Provider Selection ---
# Options: groq, gemini, openrouter, cerebras, openai, ollama
LLM_PROVIDER=groq

# ------------------------------------------------------------------------------
# 1. Groq (Free Tier & Ultra-Fast ~300-500 tok/sec)
# Sign up free: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 2. Google Gemini (Free AI Studio via OpenAI-compatible endpoint)
# Sign up free: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy_your_gemini_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ------------------------------------------------------------------------------
# 3. OpenRouter (100% Free Community Models)
# Sign up free: https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 4. Cerebras (Free Wafer Speed Inference)
# Sign up free: https://cloud.cerebras.ai
# ------------------------------------------------------------------------------
CEREBRAS_API_KEY=csk_your_cerebras_key_here
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# ------------------------------------------------------------------------------
# 5. OpenAI (Commercial)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (Local Offline) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

LLM_TIMEOUT_SECONDS=25
